# Copy to .env and change every value. .env is gitignored — never commit it.
POSTGRES_PASSWORD=change-me
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me
PHASE0_CLIENT_SECRET=change-me-long-random

# --- Phase 1 (identity legs) ---
FAKE_PING_PASSWORD=change-me
FAKE_PING_BROKER_SECRET=change-me-long-random
HOMEGROWN_CLIENT_SECRET=change-me-long-random
LEGACY_EXCHANGE_SECRET=change-me-long-random
#AUTH0_DOMAIN=your-tenant.us.auth0.com
#AUTH0_CLIENT_ID=
#AUTH0_CLIENT_SECRET=
#AUTH0_TEST_USER_EMAIL=patient1@lab.test
#AUTH0_TEST_USER_PASSWORD=

# --- Phase 2 (Konnect) ---
# Personal access token: cloud.konghq.com -> avatar -> Personal Access Tokens
KONNECT_REGION=us
KONNECT_TOKEN=kpat_change-me

# --- Phase 5 (egress + broker) ---
# Optional real-GitHub vendor leg (a GitHub App on your account; see README).
# Leave unset to run every gate headless against the mock vendor.
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=

# Written by setup-phase5.sh — leave unset:
#   INT_CLUSTER_HOST, INT_TELEMETRY_HOST, EXT_CLUSTER_HOST, EXT_TELEMETRY_HOST,
#   VAULT_DEV_ROOT_TOKEN, MOCK_CLIENT_SECRET (random), BROKER_VAULT_TOKEN (minted)
