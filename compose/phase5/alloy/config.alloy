// Audit spine (phase 6): tail every container in this compose project over
// the Docker API and push to Loki. Services emit one JSON audit line per
// event on stdout (contract §9 fields), so no parsing happens here — Loki
// stores raw lines and LogQL `| json` does the joining by token_id/hub_jti.
discovery.docker "lab" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=mcp-phase5"]
  }
}

discovery.relabel "lab" {
  targets = discovery.docker.lab.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "lab" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.lab.output
  forward_to = [loki.write.lab.receiver]
}

loki.write "lab" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
