# Copy to .env and change every value. .env is gitignored — never commit it.
POSTGRES_PASSWORD=change-me
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me
# Secret for the phase0-smoke client; substituted into the realm import.
PHASE0_CLIENT_SECRET=change-me-long-random

# --- Phase 1 ---
# fake-ping realm: password shared by the committed test users (dr-alice, bob-analyst)
FAKE_PING_PASSWORD=change-me
# fake-ping realm: secret of the mcp-plane-broker client (both realm imports substitute it)
FAKE_PING_BROKER_SECRET=change-me-long-random
# homegrown issuer: secret of its single static client svc-legacy-batch
HOMEGROWN_CLIENT_SECRET=change-me-long-random
# mcp-plane: secret of the legacy-exchange client performing RFC 8693 exchange
LEGACY_EXCHANGE_SECRET=change-me-long-random

# --- Auth0 (real free tenant; see compose/phase1/README.md) ---
# Leave unset to run without the Auth0 leg (its pytest tests skip cleanly).
#AUTH0_DOMAIN=your-tenant.us.auth0.com
#AUTH0_CLIENT_ID=
#AUTH0_CLIENT_SECRET=
#AUTH0_TEST_USER_EMAIL=patient1@lab.test
#AUTH0_TEST_USER_PASSWORD=
